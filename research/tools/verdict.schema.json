{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim",
    "verdict",
    "confidence",
    "evidence",
    "build_consistency",
    "problems",
    "what_would_refute"
  ],
  "properties": {
    "claim": {
      "type": "string",
      "description": "검증 대상 주장을 그대로 옮긴 것"
    },
    "verdict": {
      "type": "string",
      "enum": ["supported", "refuted", "unverifiable"],
      "description": "unverifiable = 레코드에 근거가 없다. 추측해서 supported로 쓰지 않는다."
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "evidence": {
      "type": "array",
      "description": "레코드에서 실제로 읽은 값만. 여기 없는 수치는 판정에 쓰지 않는다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "record_index", "field", "value", "note"],
        "properties": {
          "file": { "type": "string" },
          "record_index": { "type": "integer" },
          "field": { "type": "string" },
          "value": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "build_consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_same_build", "builds_seen", "note"],
      "properties": {
        "all_same_build": {
          "type": "boolean",
          "description": "주장이 근거로 삼는 레코드들이 전부 같은 빌드인가"
        },
        "builds_seen": {
          "type": "array",
          "items": { "type": "string" }
        },
        "note": {
          "type": "string",
          "description": "빌드가 섞였으면 어느 수치가 어느 빌드에서 왔는지"
        }
      }
    },
    "problems": {
      "type": "array",
      "description": "발견한 문제. 없으면 빈 배열. 억지로 채우지 않는다.",
      "items": { "type": "string" }
    },
    "what_would_refute": {
      "type": "string",
      "description": "이 주장을 뒤집으려면 어떤 수치가 나와야 하는가"
    }
  }
}
